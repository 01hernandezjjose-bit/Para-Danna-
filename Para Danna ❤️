<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dana: Nuestro Universo ❤️</title>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Orbitron:wght@400;700&family=Dancing+Script:wght@700&display=swap');

        body {
            margin: 0;
            padding: 0;
            background: #0b0d17;
            color: white;
            font-family: 'Montserrat', sans-serif;
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            overflow: hidden;
        }

        /* Fondo de estrellas animado */
        #stars-container {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            z-index: 1;
            background: radial-gradient(ellipse at bottom, #1B2735 0%, #090A0F 100%);
        }

        .star {
            position: absolute;
            background: white;
            border-radius: 50%;
            opacity: 0.5;
            animation: twinkle var(--duration) infinite;
        }

        @keyframes twinkle {
            0%, 100% { opacity: 0.3; transform: scale(1); }
            50% { opacity: 1; transform: scale(1.2); }
        }

        /* Tarjeta Galáctica */
        .glass-card {
            position: relative;
            z-index: 10;
            background: rgba(255, 255, 255, 0.05);
            backdrop-filter: blur(15px);
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 30px;
            padding: 40px;
            text-align: center;
            max-width: 450px;
            width: 90%;
            box-shadow: 0 0 40px rgba(138, 43, 226, 0.3);
        }

        .badge {
            font-family: 'Orbitron', sans-serif;
            font-size: 0.7rem;
            letter-spacing: 2px;
            color: #a29bfe;
            text-transform: uppercase;
            margin-bottom: 10px;
            display: block;
        }

        h1 {
            font-family: 'Dancing Script', cursive;
            font-size: 3.5rem;
            color: #ff79c6;
            margin: 10px 0;
            text-shadow: 0 0 15px rgba(255, 121, 198, 0.6);
        }

        p {
            font-size: 1.1rem;
            line-height: 1.6;
            color: #e0e0e0;
            min-height: 100px;
        }

        button {
            background: linear-gradient(45deg, #6c5ce7, #a29bfe);
            color: white;
            border: none;
            padding: 12px 30px;
            border-radius: 50px;
            font-family: 'Orbitron', sans-serif;
            font-size: 0.8rem;
            cursor: pointer;
            transition: 0.3s;
            box-shadow: 0 0 20px rgba(108, 92, 231, 0.5);
        }

        button:hover {
            transform: scale(1.05);
            box-shadow: 0 0 30px rgba(162, 155, 254, 0.8);
        }

        .spotify-frame {
            margin-top: 25px;
            border-radius: 15px;
            overflow: hidden;
            border: 1px solid rgba(255, 255, 255, 0.1);
        }

        /* Corazones espaciales */
        .floating-heart {
            position: fixed;
            pointer-events: none;
            z-index: 15;
            animation: moveUp 4s linear forwards;
        }

        @keyframes moveUp {
            to { transform: translateY(-100vh) rotate(360deg); opacity: 0; }
        }
    </style>
</head>
<body>

    <div id="stars-container"></div>

    <div class="glass-card">
        <span class="badge">Desde el 2022 en nuestro universo</span>
        <h1>Para Dana</h1>
        <p id="mainMessage">Hace 4 años, nuestro camino se cruzó para crear nuestra propia galaxia.</p>
        
        <button onclick="nextMessage()">Explorar nuestra historia</button>

        <div class="spotify-frame">
            <iframe style="border-radius:12px" src="https://open.spotify.com/embed/track/2SUpv3V2t64y945m839oGv?utm_source=generator&theme=0" width="100%" height="152" frameBorder="0" allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture" loading="lazy"></iframe>
        </div>
    </div>

    <script>
        // Crear estrellas de fondo
        const starsContainer = document.getElementById('stars-container');
        for (let i = 0; i < 150; i++) {
            const star = document.createElement('div');
            star.className = 'star';
            const size = Math.random() * 3 + 'px';
            star.style.width = size;
            star.style.height = size;
            star.style.left = Math.random() * 100 + '%';
            star.style.top = Math.random() * 100 + '%';
            star.style.setProperty('--duration', (Math.random() * 3 + 2) + 's');
            starsContainer.appendChild(star);
        }

        const mensajes = [
            "Dana, eres el sol de mi sistema solar desde el 2022.",
            "4 años luz de puro amor a tu lado.",
            "Gracias por ser mi estrella guía en este viaje infinito.",
            "Eres el descubrimiento más hermoso de mi vida.",
            "Mi amor por ti es más grande que todo el universo.",
            "Por una eternidad viajando juntos entre estrellas.",
            "4 años y mi mundo sigue girando alrededor de ti."
        ];

        let currentIdx = 0;

        function nextMessage() {
            const p = document.getElementById('mainMessage');
            currentIdx = (currentIdx + 1) % mensajes.length;
            p.style.opacity = 0;
            
            setTimeout(() => {
                p.innerText = mensajes[currentIdx];
                p.style.opacity = 1;
            }, 300);

            createHeart();
        }

        function createHeart() {
            for(let i=0; i<8; i++) {
                const heart = document.createElement('div');
                heart.className = 'floating-heart';
                heart.innerHTML = ['❤️', '✨', '🛸', '💖'][Math.floor(Math.random()*4)];
                heart.style.left = Math.random() * 100 + 'vw';
                heart.style.bottom = '-5vh';
                heart.style.fontSize = (Math.random() * 20 + 20) + 'px';
                document.body.appendChild(heart);
                setTimeout(() => heart.remove(), 4000);
            }
        }
    </script>
</body>
</html>

